# Copy to .env.local and fill in. See docs/SETUP.md for where to find each value.
# Leaving the Supabase vars unset runs the app against LocalRepo (.data/db.json) with no auth.

# --- Supabase (phase 1b, database only — auth does not use Supabase, see below) ---
# Project URL — safe to expose to the client (only used to pick the repo adapter).
NEXT_PUBLIC_SUPABASE_URL=
# Secret service-role key — server-only, never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Management API token + project ref, used only by scripts/migrate.mjs (applies
# supabase/migrations/*.sql via the Management API — no direct DB password needed).
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Auth: single-user app password + signed session cookie ---
# Any plain string; the login page checks it in constant time.
APP_PASSWORD=
# Random secret (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
# used to HMAC-sign the session cookie and the password check. Auth is active whenever
# APP_PASSWORD and SESSION_SECRET are both set, independent of the repo adapter; unset
# in local mode to skip auth entirely.
SESSION_SECRET=

# --- Machine API bearer tokens ---
# POST /api/capture (iOS Shortcut / share sheet -> quick memo)
CAPTURE_TOKEN=
# POST /api/ingest (status collector -> status_snapshot / project_activity)
INGEST_TOKEN=
# GET /api/cron/daily — Vercel sends this as `Authorization: Bearer ${CRON_SECRET}`
CRON_SECRET=
# GET /api/collector/config (scripts/collector.mjs reads which projects to probe) —
# reuses INGEST_TOKEN, same PC-side collector as POST /api/ingest.
# GET /api/agent-inbox, POST /api/agent-inbox/done (scripts/cc-inbox.mjs SessionStart hook)
AGENT_TOKEN=

# --- Local-only ---
# Base URL of the local trading dashboard probe. Defaults to http://127.0.0.1:8899.
TRADING_URL=
# Set to 0 to disable local status probes (git/trading), e.g. when deployed.
LOCAL_PROBES=
# Base URL of the deployed app, used by scripts/collector.mjs to POST to /api/ingest and GET /api/collector/config.
CLOUD_URL=
